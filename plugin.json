{
  "name": "legion",
  "displayName": "LegionIO",
  "version": "2.0.0",
  "description": "LegionIO inference runtime for Kai. Routes all LLM calls through the LegionIO daemon when enabled and online.",
  "icon": {
    "lucide": "cpu"
  },
  "author": "John Hollow <https://github.com/iamhollow>",
  "permissions": [
    "config:read",
    "config:write",
    "tools:register",
    "ui:banner",
    "ui:settings",
    "network:fetch",
    "state:publish",
    "agent:inference-provider",
    "agent:register-runtime",
    "agent:register-cli-tool"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "daemonUrl": {
        "type": "string",
        "default": "http://127.0.0.1:4567"
      }
    }
  }
}
